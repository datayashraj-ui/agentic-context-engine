# NEXUS Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to git

# ============================================================
# DOMAIN
# ============================================================
BASE_DOMAIN=yourdomain.com

# ============================================================
# TELEGRAM
# ============================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
FOUNDER_TELEGRAM_ID=your_telegram_numeric_user_id

# ============================================================
# WHATSAPP
# ============================================================
FOUNDER_PHONE_NUMBER=+1234567890

# ============================================================
# AI MODEL API KEYS
# ============================================================
GOOGLE_API_KEY=your_google_ai_studio_api_key
GROQ_API_KEY=your_groq_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key_for_cto_agent

# ============================================================
# INSFORGE (Database + Auth + Storage)
# ============================================================
INSFORGE_JWT_SECRET=generate_with_openssl_rand_base64_32
INSFORGE_ADMIN_EMAIL=admin@yourdomain.com
INSFORGE_ADMIN_PASSWORD=strong_password_here
INSFORGE_DB_PASSWORD=strong_db_password_here

# ============================================================
# N8N (Automation)
# ============================================================
N8N_USER=admin
N8N_PASSWORD=strong_n8n_password
N8N_ENCRYPTION_KEY=generate_with_openssl_rand_hex_16

# ============================================================
# CHATWOOT (Customer Support)
# ============================================================
CHATWOOT_SECRET_KEY=generate_with_openssl_rand_hex_64
CHATWOOT_DB_PASSWORD=strong_chatwoot_db_password

# ============================================================
# TWENTY CRM
# ============================================================
TWENTY_SECRET=generate_with_openssl_rand_hex_32
TWENTY_DB_PASSWORD=strong_twenty_db_password

# ============================================================
# POSTHOG (Analytics)
# ============================================================
POSTHOG_SECRET=generate_with_openssl_rand_hex_32
POSTHOG_DB_PASSWORD=strong_posthog_db_password

# ============================================================
# GLITCHTIP (Error Monitoring)
# ============================================================
GLITCHTIP_SECRET=generate_with_openssl_rand_hex_32
GLITCHTIP_DB_PASSWORD=strong_glitchtip_db_password

# ============================================================
# LANGFUSE (LLM Observability)
# ============================================================
LANGFUSE_SECRET=generate_with_openssl_rand_hex_32
LANGFUSE_SALT=generate_with_openssl_rand_hex_16
LANGFUSE_DB_PASSWORD=strong_langfuse_db_password
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key

# ============================================================
# COGNEE (Agent Memory)
# ============================================================
COGNEE_API_KEY=generate_with_openssl_rand_hex_32

# ============================================================
# TAILSCALE
# ============================================================
TAILSCALE_AUTH_KEY=tskey-auth-your_tailscale_auth_key

# ============================================================
# STRIPE (Payments)
# ============================================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# ============================================================
# EMAIL (SMTP for notifications)
# ============================================================
SUPPORT_EMAIL=support@yourdomain.com
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# ============================================================
# BEADS (Task Management)
# ============================================================
BEADS_API_KEY=your_beads_api_key

# ============================================================
# COOLIFY (Deployment Platform — installed separately)
# Access at: https://deploy.yourdomain.com or :8000
# ============================================================
COOLIFY_WEBHOOK_URL=https://deploy.yourdomain.com/webhooks/deploy/your_token
